FROM python:3.12-slim

# Docker CLI direkt vom Host einbinden (per Volume-Mount in docker-compose.yml),
# hier nur die Python-Abhängigkeiten installieren
RUN pip install fastapi "uvicorn[standard]"

WORKDIR /app

COPY watchdog.py .

CMD ["uvicorn", "watchdog:app", "--host", "0.0.0.0", "--port", "8012"]
